{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LBDistrictScouts/DistrictWordpressPlugin/schema/coordinator-issue-message.schema.json",
  "title": "Coordinator Issue ingestion message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "external_id",
    "title",
    "issue_date",
    "issue_year",
    "issue_month",
    "pdf_url"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "external_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "issue_date": { "type": "string", "format": "date" },
    "issue_year": { "type": "integer", "minimum": 1900, "maximum": 9999 },
    "issue_month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "pdf_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "description": { "type": "string", "maxLength": 5000 },
    "preview_image_url": { "type": "string", "format": "uri", "pattern": "^https://" }
  }
}
