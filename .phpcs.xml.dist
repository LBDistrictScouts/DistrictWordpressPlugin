<?xml version="1.0"?>
<ruleset name="District WordPress Plugin">
    <description>WordPress Coding Standards for District WordPress Plugin</description>

    <!-- Include WordPress standards -->
    <rule ref="WordPress"/>

    <!-- Include WordPress documentation standards -->
    <rule ref="WordPress-Docs"/>

    <!-- Exclude VIP-specific rules -->
    <rule ref="WordPress.Security.NonceVerification.Missing">
        <severity>warning</severity>
    </rule>

    <!-- These smoke tests intentionally read plugin files as fixtures. -->
    <rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
        <severity>0</severity>
    </rule>

    <exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>

    <!-- Paths to check -->
    <arg name="basepath" value="."/>
    <file>src/</file>
    <file>tests/</file>

    <!-- Exclude paths -->
    <exclude-pattern>/vendor/</exclude-pattern>
    <exclude-pattern>/build/</exclude-pattern>
    <exclude-pattern>/coverage/</exclude-pattern>
    <exclude-pattern>/node_modules/</exclude-pattern>

    <!-- Show progress -->
    <arg value="p"/>

    <!-- Use colors -->
    <arg name="colors"/>

    <!-- Show sniff codes -->
    <arg value="s"/>

    <!-- Report error codes -->
    <arg value="e"/>

</ruleset>
