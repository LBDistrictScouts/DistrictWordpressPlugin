<?xml version="1.0"?>
<ruleset name="District WordPress Plugin">
    <description>WordPress Coding Standards for District WordPress Plugin</description>

    <!-- Include WordPress standards -->
    <rule ref="WordPress"/>

    <!-- Include WordPress documentation standards -->
    <rule ref="WordPress-Docs"/>

    <!-- Exclude specific WordPress rules that may be overly strict -->
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <properties>
            <property name="customPropertiesWhitelist" type="array">
                <element value="post_type"/>
                <element value="post_mime_type"/>
                <element value="post_status"/>
            </property>
        </properties>
    </rule>

    <!-- Exclude VIP-specific rules -->
    <rule ref="WordPress.Security.NonceVerification.Missing">
        <severity>warning</severity>
    </rule>

    <!-- Paths to check -->
    <arg name="basepath" value="."/>
    <file>src/</file>
    <file>tests/</file>

    <!-- Exclude paths -->
    <exclude-pattern>/vendor/</exclude-pattern>
    <exclude-pattern>/build/</exclude-pattern>
    <exclude-pattern>/coverage/</exclude-pattern>
    <exclude-pattern>/node_modules/</exclude-pattern>

    <!-- Show progress -->
    <arg value="p"/>

    <!-- Use colors -->
    <arg name="colors"/>

    <!-- Show sniff codes -->
    <arg value="s"/>

    <!-- Report error codes -->
    <arg value="e"/>

</ruleset>
