{
  "name": "lbdistrictscouts/district-wordpress-plugin",
  "description": "Custom Post Types for District CMS",
  "type": "wordpress-plugin",
  "autoload": {
    "psr-4": {
      "LBDistrictScouts\\\\DistrictWordpressPlugin\\\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LBDistrictScouts\\\\DistrictWordpressPlugin\\\\Tests\\\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6"
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html coverage"
  }
}
