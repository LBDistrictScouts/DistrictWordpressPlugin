{
  "name": "lbdistrictscouts/district-wordpress-plugin",
  "description": "Custom Post Types for District CMS",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "LBDistrictScouts\\\\DistrictWordpressPlugin\\\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LBDistrictScouts\\\\DistrictWordpressPlugin\\\\Tests\\\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpunit/php-code-coverage": "^10.0",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6",
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0",
    "php-parallel-lint/php-parallel-lint": "^1.3",
    "php-parallel-lint/php-console-highlighter": "^1.0",
    "phpstan/phpstan": "^1.10"
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html coverage --coverage-clover coverage.xml",
    "lint": "parallel-lint --exclude vendor src tests",
    "phpstan": "phpstan analyse --level 5 src",
    "phpcs": "phpcs --standard=WordPress src tests --ignore=vendor",
    "phpcs:fix": "phpcbf --standard=WordPress src tests --ignore=vendor",
    "quality": [
      "@lint",
      "@phpcs",
      "@phpstan",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
